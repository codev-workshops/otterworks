{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OtterWorks Notification Events (inbound contract + unproduced outbound shapes)",
  "description": "notification-service is a CONSUMER of bus events: services/notification-service/src/main/kotlin/com/otterworks/notification/consumer/SqsConsumer.kt decodes each SQS body (optionally SNS-wrapped) into the camelCase `SqsNotificationMessage` defined below (model/NotificationEvent.kt) and only acts on eventType in {file_shared, comment_added, document_edited, user_mentioned}. The service has no SNS/SQS publisher, so NotificationSent/Read/Failed are outbound shapes that nothing currently produces; they are kept as documentation only. Note: the wire format consumed today is camelCase and does not match the snake_case document-service envelope, so comment_added from document-service is not decodable by this consumer (see docs/labs/contract-audit-guide.md).",
  "definitions": {
    "SqsNotificationMessage": {
      "description": "Inbound message shape decoded by SqsConsumer (kotlinx.serialization, ignoreUnknownKeys). Only eventType and timestamp are required; the others default to empty strings.",
      "type": "object",
      "required": ["eventType", "timestamp"],
      "properties": {
        "eventType": { "enum": ["file_shared", "comment_added", "document_edited", "user_mentioned"] },
        "fileId": { "type": "string" },
        "ownerId": { "type": "string" },
        "sharedWithUserId": { "type": "string" },
        "documentId": { "type": "string" },
        "commentId": { "type": "string" },
        "userId": { "type": "string" },
        "actorId": { "type": "string" },
        "mentionedUserId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "NotificationSentEvent": {
      "type": "object",
      "required": ["eventType", "notificationId", "userId", "type", "channel", "timestamp"],
      "properties": {
        "eventType": { "const": "notification_sent" },
        "notificationId": { "type": "string", "format": "uuid" },
        "userId": { "type": "string", "format": "uuid" },
        "type": { "enum": ["mention", "share", "comment", "system"] },
        "channel": { "enum": ["email", "in_app", "push"] },
        "subject": { "type": "string" },
        "resourceId": { "type": "string", "format": "uuid" },
        "resourceType": { "enum": ["document", "file", "folder"] },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "NotificationReadEvent": {
      "type": "object",
      "required": ["eventType", "notificationId", "userId", "timestamp"],
      "properties": {
        "eventType": { "const": "notification_read" },
        "notificationId": { "type": "string", "format": "uuid" },
        "userId": { "type": "string", "format": "uuid" },
        "readAt": { "type": "string", "format": "date-time" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "NotificationFailedEvent": {
      "type": "object",
      "required": ["eventType", "notificationId", "userId", "channel", "errorCode", "timestamp"],
      "properties": {
        "eventType": { "const": "notification_failed" },
        "notificationId": { "type": "string", "format": "uuid" },
        "userId": { "type": "string", "format": "uuid" },
        "channel": { "enum": ["email", "in_app", "push"] },
        "errorCode": { "type": "string" },
        "errorMessage": { "type": "string" },
        "retryCount": { "type": "integer", "default": 0 },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    }
  }
}
