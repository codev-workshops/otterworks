{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OtterWorks Collaboration WebSocket Messages",
  "description": "Real-time presence messages broadcast by collab-service over Socket.IO document rooms (`doc:<documentId>`), see services/collab-service/src/handlers/collaboration.ts. These are NOT SNS/SQS bus events: collab-service has no SNS producer, and the Socket.IO event name (e.g. 'user-joined') is carried by the transport rather than as an eventType field in the payload. Each definition below documents the payload of one Socket.IO event; the `x-socketio-event` keyword records the event name.",
  "definitions": {
    "CursorPosition": {
      "type": "object",
      "required": ["index", "length"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "length": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "UserJoinedMessage": {
      "x-socketio-event": "user-joined",
      "type": "object",
      "required": ["userId", "displayName", "color", "socketId"],
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "socketId": { "type": "string" }
      },
      "additionalProperties": false
    },
    "UserLeftMessage": {
      "x-socketio-event": "user-left",
      "type": "object",
      "required": ["socketId", "userId"],
      "properties": {
        "socketId": { "type": "string" },
        "userId": { "type": "string" }
      },
      "additionalProperties": false
    },
    "CursorUpdateMessage": {
      "x-socketio-event": "cursor-update",
      "type": "object",
      "required": ["socketId", "userId", "displayName", "color", "cursor", "selection"],
      "properties": {
        "socketId": { "type": "string" },
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "cursor": { "oneOf": [{ "$ref": "#/definitions/CursorPosition" }, { "type": "null" }] },
        "selection": { "oneOf": [{ "$ref": "#/definitions/CursorPosition" }, { "type": "null" }] }
      },
      "additionalProperties": false
    },
    "TypingIndicatorMessage": {
      "x-socketio-event": "typing-indicator",
      "type": "object",
      "required": ["socketId", "userId", "displayName", "isTyping"],
      "properties": {
        "socketId": { "type": "string" },
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "isTyping": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
