# Otter Projects runtime configuration. In-cluster these come from the
# `otter-projects` Secret. NEVER commit real values.

# Run with the JSON-file store instead of DynamoDB (npm run dev sets this).
LOCAL_MODE=true
LOCAL_STORE_PATH=.otter-projects.local.json

# Passcode compared (constant-time) at /api/auth/login.
PROJECTS_PASSCODE=
# HMAC secret used to sign the ow_projects_session cookie.
SESSION_SECRET=
# Bearer token for the REST API and inbound webhooks.
PROJECTS_API_KEY=
# HMAC secret: signs outbound webhooks (X-OtterProjects-Signature) and verifies inbound ones.
PROJECTS_WEBHOOK_SECRET=

# Public base URL used to build callback_url in outbound payloads.
PUBLIC_URL=http://localhost:3000

# DynamoDB (ignored in LOCAL_MODE).
PROJECTS_TABLE=otterworks-projects
AWS_REGION=us-east-1

# Devin v3 API (devin-api dispatcher + poller).
DEVIN_API_KEY=
DEVIN_ORG_ID=
# Default target for the webhook dispatcher: a Devin Automation webhook trigger.
DEVIN_WEBHOOK_URL=
DEVIN_WEBHOOK_SECRET=
