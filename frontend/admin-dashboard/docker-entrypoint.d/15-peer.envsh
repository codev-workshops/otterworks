#!/bin/sh
# Sourced by the nginx image entrypoint before the templates are rendered.
# Derives the /peer proxy settings from PEER_APP_URL (see nginx.conf.template).
PEER_APP_URL="$(printf '%s' "${PEER_APP_URL:-}" | sed 's:/*$::')"
if [ -n "${PEER_APP_URL}" ]; then
  PEER_PROXY_URL="/peer"
  PEER_UPSTREAM="${PEER_APP_URL}"
else
  PEER_PROXY_URL=""
  PEER_UPSTREAM="http://127.0.0.1:4200"
fi
export PEER_APP_URL PEER_PROXY_URL PEER_UPSTREAM
